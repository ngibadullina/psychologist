---
import '~/styles/global.css';
import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import Seo from '~/components/Seo.astro';
import { SITE } from '~/config/site';
import { withBase } from '~/utils/url';

interface Props {
  /** Заголовок страницы без названия сайта */
  title?: string;
  /** Описание для meta description */
  description?: string;
}

const { title, description = SITE.description } = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;

/** Страница без собственного заголовка — это главная */
const isHome = !title;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={pageTitle} description={description} isHome={isHome} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href={withBase('/favicon-192.png')}
    />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до основного вмісту</a>

    <Header />

    <main id="main" class="page-main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
