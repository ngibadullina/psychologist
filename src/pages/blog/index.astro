---
import ArticleCard from '~/components/ArticleCard.astro';
import Section from '~/components/Section.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getPublishedPosts } from '~/utils/blog';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Блог"
  description="Статті про психологію, емоції та турботу про себе."
>
  <Section>
    <h1>Блог</h1>
    <p class="lead">Статті про емоції, стосунки та турботу про себе.</p>

    {
      posts.length > 0 ? (
        <div class="card-grid blog__list">
          {posts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      ) : (
        <p class="blog__empty text-muted">Перші статті з’являться найближчим часом.</p>
      )
    }
  </Section>
</BaseLayout>

<style>
  .blog__list,
  .blog__empty {
    margin-block-start: var(--space-xl);
  }
</style>
