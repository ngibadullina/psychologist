---
import Section from '~/components/Section.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Блог"
  description="Статті про психологію, емоції та турботу про себе."
>
  <Section narrow>
    <h1>Блог</h1>
    <p class="lead">Статті про емоції, стосунки та турботу про себе.</p>
    <p class="text-muted">
      Розділ у розробці. На окремому етапі підключимо Astro Content Collections,
      картки статей, категорії, теги та RSS.
    </p>
  </Section>
</BaseLayout>
