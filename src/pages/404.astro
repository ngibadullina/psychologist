---
import Button from '~/components/Button.astro';
import Section from '~/components/Section.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { BLOG_ENABLED } from '~/config/site';
import { withBase } from '~/utils/url';
---

<BaseLayout
  title="Сторінку не знайдено"
  description="Такої сторінки немає. Поверніться на головну або перегляньте інші розділи."
>
  <Section narrow>
    <p class="notfound__code">404</p>
    <h1>Такої сторінки немає</h1>
    <p class="lead">
      Можливо, адреса змінилася або в посиланні є помилка.
    </p>

    <div class="notfound__actions">
      <Button href={withBase('/')}>На головну</Button>
      {
        BLOG_ENABLED && (
          <Button href={withBase('/blog/')} variant="secondary">
            До блогу
          </Button>
        )
      }
      <Button href={withBase('/about/')} variant="secondary">Про мене</Button>
      <Button href={withBase('/contacts/')} variant="ghost">Контакти</Button>
    </div>
  </Section>
</BaseLayout>

<style>
  .notfound__code {
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: var(--fs-2xl);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-lg);
  }
</style>
