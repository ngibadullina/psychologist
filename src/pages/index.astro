---
import Button from '~/components/Button.astro';
import ContactBlock from '~/components/ContactBlock.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SERVICE_GROUPS } from '~/config/services';
import { withBase } from '~/utils/url';
---

<BaseLayout>
  <Hero />

  <Section title="Мій підхід" narrow variant="subtle">
    <p>
      Я — психолог-консультант, <span class="nowrap">гештальт-терапевт</span>.
      У своїй роботі допомагаю людині краще зрозуміти себе, свої емоції та
      внутрішні процеси.
    </p>
    <p>
      Мені важливо не просто «прибрати симптом», а допомогти знайти глибші
      причини стану та відновити контакт із собою. Я створюю безпечний простір,
      де можна бути собою, краще почути себе і поступово знаходити внутрішню
      опору та ясність у житті.
    </p>
    <p class="section-actions">
      <Button href={withBase('/about/')} variant="ghost">
        Докладніше про підхід
      </Button>
    </p>
  </Section>

  <Section title="Запити, з якими працюю">
    <div class="card-grid">
      {SERVICE_GROUPS.map((group) => <ServiceCard group={group} />)}
    </div>
    <p class="section-actions">
      <Button href={withBase('/services/')} variant="ghost">
        Докладніше про запити
      </Button>
    </p>
  </Section>

  <Section title="Формат консультацій" narrow variant="subtle">
    <dl class="format-list">
      <dt>Тривалість</dt>
      <dd>50–60 хвилин <em class="text-muted">(уточнити)</em></dd>

      <dt>Періодичність</dt>
      <dd>Зазвичай раз на тиждень <em class="text-muted">(уточнити)</em></dd>

      <dt>Формат</dt>
      <dd>Онлайн у зручному месенджері або очно <em class="text-muted">(уточнити)</em></dd>

      <dt>Запис</dt>
      <dd>Через пошту, Telegram або Instagram</dd>
    </dl>
    <p class="section-actions">
      <Button href={withBase('/format/')} variant="ghost">
        Як проходить консультація
      </Button>
    </p>
  </Section>

  <Section title="Освіта та навчання" narrow>
    <p>
      Бакалавр психології, Житомирський інститут МАУП, 2025 рік.
    </p>
    <p>
      Професійне навчання: гештальт-терапія та сімейна системна терапія (MIGIS),
      основи психоаналізу і сучасної психосоматики (Міжнародний інститут
      психології), арт-терапія (International Training Company «Osnova»).
    </p>
    <p class="section-actions">
      <Button href={withBase('/about/')} variant="ghost">
        Повний перелік навчання
      </Button>
    </p>
  </Section>

  <Section title="Останні статті" variant="subtle">
    <p class="text-muted">
      Блог з’явиться на наступному етапі — тоді тут автоматично відображатимуться
      три останні статті.
    </p>
    <p class="section-actions">
      <Button href={withBase('/blog/')} variant="ghost">Перейти до блогу</Button>
    </p>
  </Section>

  <Section title="Зв’язатися та записатися" narrow>
    <p class="lead">
      Напишіть зручним способом — відповім і домовимося про час зустрічі.
    </p>
    <div class="contacts-wrap">
      <ContactBlock />
    </div>
  </Section>
</BaseLayout>

<style>
  .section-actions {
    margin-block-start: var(--space-lg);
  }

  .format-list {
    display: grid;
    gap: var(--space-3xs) var(--space-md);
  }

  .format-list dt {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  .format-list dd {
    margin: 0;
    margin-block-end: var(--space-2xs);
  }

  .contacts-wrap {
    margin-block-start: var(--space-lg);
  }

  @media (min-width: 36em) {
    .format-list {
      grid-template-columns: 10rem 1fr;
      align-items: baseline;
    }

    .format-list dd {
      margin-block-end: 0;
    }
  }
</style>
