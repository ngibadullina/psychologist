---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

import { DEGREES } from '~/config/education';
import { BLOG_ENABLED, CONTACTS, INSTAGRAM_ENABLED, SITE } from '~/config/site';
import { withBase } from '~/utils/url';

/**
 * Метаданные страницы: title, description, canonical,
 * Open Graph и Twitter Card для превью ссылки в мессенджерах,
 * JSON-LD с данными о специалисте — только на главной,
 * JSON-LD статьи — только на страницах блога.
 *
 * В структурированные данные попадает лишь то, что подтверждено:
 * имя, специализация, контакты, базовое образование.
 * Ни отзывов, ни рейтингов, ни оценок квалификации.
 */
interface ArticleMeta {
  /** Заголовок статьи без названия сайта */
  headline: string;
  publishDate: Date;
  updatedDate?: Date | undefined;
  author: string;
  category?: string | undefined;
  tags: string[];
}

interface Props {
  /** Готовый заголовок страницы */
  title: string;
  description: string;
  /** Главная получает расширенную разметку профиля */
  isHome?: boolean;
  /** Картинка для превью ссылки. Без неё — общая og-image.jpg */
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  /** Страница статьи: og:type=article и разметка BlogPosting */
  article?: ArticleMeta | undefined;
}

const { title, description, isHome = false, image, imageAlt, article } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL(withBase('/'), Astro.site).href;
const siteImageUrl = new URL(withBase('/og-image.jpg'), Astro.site).href;

/**
 * Обложку подрезаем под пропорции превью 1200×630, чтобы мессенджеры
 * не кадрировали её сами. Astro не увеличивает картинки, поэтому
 * у маленькой обложки размер превью уменьшается с сохранением пропорций.
 */
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;

const ogWidth = image
  ? Math.min(OG_WIDTH, image.width, Math.floor((image.height * OG_WIDTH) / OG_HEIGHT))
  : OG_WIDTH;
const ogHeight = Math.round((ogWidth * OG_HEIGHT) / OG_WIDTH);

const ogImage = image
  ? await getImage({ src: image, width: ogWidth, height: ogHeight, fit: 'cover', format: 'jpg' })
  : undefined;
const ogImageUrl = ogImage ? new URL(ogImage.src, Astro.site).href : siteImageUrl;
const ogImageAlt = (ogImage && imageAlt) || `${SITE.author} — ${SITE.role}`;

/** Профили, на которые можно ссылаться. Скрытые в конфиге сюда не попадают. */
const profiles = [
  CONTACTS.telegram.url,
  ...(INSTAGRAM_ENABLED ? [CONTACTS.instagram.url] : []),
];

const degree = DEGREES[0];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  jobTitle: SITE.role,
  description: SITE.description,
  url: homeUrl,
  image: siteImageUrl,
  email: `mailto:${CONTACTS.email}`,
  knowsLanguage: SITE.lang,
  sameAs: profiles,
  ...(degree
    ? {
        alumniOf: {
          '@type': 'CollegeOrUniversity',
          name: degree.institution,
        },
      }
    : {}),
};

const articleJsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.headline,
  description,
  image: ogImageUrl,
  datePublished: article.publishDate.toISOString(),
  dateModified: (article.updatedDate ?? article.publishDate).toISOString(),
  author: {
    '@type': 'Person',
    name: article.author,
    url: homeUrl,
  },
  mainEntityOfPage: canonicalUrl,
  inLanguage: SITE.lang,
  ...(article.tags.length > 0 ? { keywords: article.tags.join(', ') } : {}),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{
  BLOG_ENABLED && (
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Блог — ${SITE.author}`}
      href={withBase('/rss.xml')}
    />
  )
}

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={ogImageAlt} />

{
  article && (
    <Fragment>
      <meta property="article:published_time" content={article.publishDate.toISOString()} />
      {article.updatedDate && (
        <meta property="article:modified_time" content={article.updatedDate.toISOString()} />
      )}
      <meta property="article:author" content={article.author} />
      {article.category && <meta property="article:section" content={article.category} />}
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </Fragment>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{
  isHome && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personJsonLd)}
    />
  )
}

{
  articleJsonLd && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(articleJsonLd)}
    />
  )
}
