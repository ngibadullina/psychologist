---
/**
 * Универсальная кнопка.
 * С `href` рендерится как <a>, без него — как <button>.
 * Внешние ссылки помечайте external — добавятся target и rel.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  external = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['button', `button--${variant}`, className];
const externalAttrs = external ? { target: '_blank', rel: 'noopener' } : {};
---

{
  href ? (
    <a href={href} class:list={classes} {...externalAttrs} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
