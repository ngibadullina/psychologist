---
/**
 * Навигационная цепочка: Головна › Блог › Название статьи.
 * Последний пункт — текущая страница, без ссылки.
 */
interface Crumb {
  label: string;
  /** Уже с учётом base — через withBase() */
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Навігаційний ланцюжок">
  <ol class="breadcrumbs__list">
    {
      items.map((item) => (
        <li class="breadcrumbs__item">
          {item.href ? (
            <a class="breadcrumbs__link" href={item.href}>
              {item.label}
            </a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs__item + .breadcrumbs__item::before {
    content: '›';
    margin-inline-end: var(--space-3xs);
    color: var(--color-border-strong);
  }

  .breadcrumbs__link {
    color: var(--color-text-muted);
  }

  .breadcrumbs__link:hover {
    color: var(--color-accent);
  }
</style>
